{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tinor-Tech/invalid-state-admissions-benchmark/schemas/ground-truth.schema.json",
  "title": "Ground truth (scorer-only, v2)",
  "type": "object",
  "required": [
    "id",
    "label",
    "title",
    "benchmarkVersion",
    "family",
    "nature",
    "v1Case",
    "propositions",
    "reads"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(case|probe)-[0-9a-f]{6}$"
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z][0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "benchmarkVersion": {
      "const": "2.0.0"
    },
    "family": {
      "type": "string"
    },
    "nature": {
      "enum": [
        "synthetic",
        "production",
        "real-regression",
        "independently-verified"
      ]
    },
    "v1Case": {
      "type": [
        "string",
        "null"
      ]
    },
    "propositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposition"
      }
    },
    "reads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/read"
      }
    }
  },
  "$defs": {
    "proposition": {
      "type": "object",
      "required": [
        "id",
        "step",
        "candidate",
        "target",
        "acceptable",
        "rules",
        "why",
        "criticalIfPersisted"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "candidate": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "acceptable": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string",
          "minLength": 10
        },
        "criticalIfPersisted": {
          "enum": [
            null,
            "UNAUTHORIZED_WRITE"
          ]
        }
      }
    },
    "alternative": {
      "type": "object",
      "required": [
        "outcome",
        "reason",
        "record"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "ADMIT",
            "ADMIT-QUALIFIED",
            "HOLD",
            "REFUSE",
            "NO-CHANGE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expectedRecord"
            }
          ]
        }
      }
    },
    "expectedRecord": {
      "type": "object",
      "required": [
        "recordType"
      ],
      "additionalProperties": false,
      "properties": {
        "recordType": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "attributedTo": {
          "type": "string"
        },
        "actingFor": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "fieldsIncludes": {
          "type": "object"
        },
        "optionalFields": {
          "type": "object",
          "description": "Allowed variance (2.1): fields a record may omit or carry with exactly this value. Any other non-null field not in fields or fieldsIncludes is unsupported."
        },
        "evidenceMaterials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validity": {
          "type": "object"
        },
        "audience": {
          "type": [
            "array",
            "null"
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "withdraws": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmedBy": {
          "type": "array"
        }
      }
    },
    "read": {
      "type": "object",
      "required": [
        "read",
        "expected",
        "restricted",
        "rules",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "string"
        },
        "restricted": {
          "type": "boolean"
        },
        "rules": {
          "type": "array"
        },
        "why": {
          "type": "string"
        },
        "expected": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "value",
                "none",
                "conflicting"
              ]
            },
            "recordType": {
              "type": "string"
            },
            "attributedTo": {
              "type": "string"
            },
            "fields": {
              "type": "object"
            },
            "qualifiers": {
              "type": "array"
            },
            "optionalQualifiers": {
              "type": "array"
            },
            "claims": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}
