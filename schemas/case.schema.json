{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tinor-Tech/invalid-state-admissions-benchmark/schemas/case.schema.json",
  "title": "Case (system-visible input, v2)",
  "description": "Everything a system under test may see. Expected outcomes, reasons, records and answers live only in ground-truth/.",
  "type": "object",
  "required": [
    "id",
    "benchmarkVersion",
    "contracts",
    "parties",
    "accounts",
    "grants",
    "initialState",
    "materials",
    "steps",
    "reads"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(case|probe)-[0-9a-f]{6}$",
      "description": "Opaque id. The readable label, family and title are in ground-truth/ so that the input does not cue the answer."
    },
    "benchmarkVersion": {
      "const": "2.0.0"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "emailDomains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "party"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "party": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "account",
          "party",
          "scopes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "party": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "enum": [
                "submit",
                "commit",
                "attest"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "initialState": {
      "type": "object",
      "required": [
        "records"
      ],
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "record.schema.json"
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "reads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/read"
      }
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "from",
        "receivedAt",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "fromAddress": {
          "type": "string"
        },
        "receivedAt": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "at",
        "submittedBy",
        "request",
        "candidates"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "submittedBy": {
          "type": "string"
        },
        "request": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "ref",
        "target",
        "recordType",
        "subject",
        "attributedTo",
        "actingFor",
        "fields",
        "evidence",
        "validity"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "recordType": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "attributedTo": {
          "type": "string"
        },
        "actingFor": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "evidence": {
          "type": "array"
        },
        "validity": {
          "type": "object"
        },
        "audience": {
          "type": [
            "array",
            "null"
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "withdraws": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmedBy": {
          "type": [
            "array",
            "null"
          ]
        }
      }
    },
    "read": {
      "type": "object",
      "required": [
        "id",
        "viewer",
        "subject",
        "target",
        "match",
        "asOf",
        "knownAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "viewer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "match": {
          "type": "object"
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "knownAt": {
          "type": "string"
        }
      }
    }
  }
}
