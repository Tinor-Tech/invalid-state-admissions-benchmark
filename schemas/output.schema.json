{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tinor-Tech/invalid-state-admissions-benchmark/schemas/output.schema.json",
  "title": "Run output (v2.1; v2 still accepted). Produced by run.mjs from an adapter session, or recorded by any other harness. isa-run-output/2.1 adds per-case snapshots; isa-run-output/2 files have none and are scored on records only.",
  "type": "object",
  "required": ["benchmarkVersion", "outputSchema", "adapter", "outputs"],
  "properties": {
    "benchmarkVersion": { "enum": ["2.0.0", "2.1.0"] },
    "outputSchema": { "enum": ["isa-run-output/2", "isa-run-output/2.1"] },
    "adapter": { "type": "object", "required": ["name", "kind"], "properties": { "name": { "type": "string" }, "kind": { "enum": ["trivial", "reference", "mock", "harness", "recorded", "system-under-test"] }, "description": { "type": "string" }, "contract": { "type": "string" } } },
    "outputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/caseOutput" } }
  },
  "$defs": {
    "caseOutput": { "type": "object", "required": ["decisions", "records", "answers", "error"], "properties": {
      "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
      "records": { "type": "array", "items": { "$ref": "record.schema.json" } },
      "answers": { "type": "array", "items": { "$ref": "#/$defs/answer" } },
      "snapshots": { "type": "array", "description": "isa-run-output/2.1: the exported state after each step (after = step id, or init for a case without steps) and after all reads (after = reads).", "items": { "$ref": "#/$defs/snapshot" } },
      "error": { "type": ["string", "null"] },
      "elapsedMs": { "type": "number" }, "cost": { "type": "object" } } },
    "snapshot": { "type": "object", "required": ["after", "records"], "additionalProperties": false, "properties": {
      "after": { "type": "string" }, "records": { "type": "array", "items": { "$ref": "record.schema.json" } } } },
    "decision": { "type": "object", "required": ["candidate", "outcome", "reason"], "additionalProperties": false, "properties": {
      "candidate": { "type": "string" }, "target": { "type": "string" },
      "outcome": { "enum": ["ADMIT", "ADMIT-QUALIFIED", "HOLD", "REFUSE", "NO-CHANGE"] }, "reason": { "type": ["string", "null"] } } },
    "answer": { "type": "object", "required": ["read", "status"], "additionalProperties": false, "properties": {
      "read": { "type": "string" }, "status": { "enum": ["value", "none", "conflicting"] }, "recordType": { "type": "string" }, "attributedTo": { "type": "string" },
      "fields": { "type": "object" }, "qualifiers": { "type": "array", "items": { "type": "string" } },
      "claims": { "type": "array", "items": { "type": "object", "required": ["attributedTo", "fields"], "properties": { "attributedTo": { "type": "string" }, "recordType": { "type": "string" }, "fields": { "type": "object" } } } } } }
  }
}
